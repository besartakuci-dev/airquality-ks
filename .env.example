# Copy this file to .env and replace the placeholder values. Never commit .env.
# docker-compose.yml reads every credential and host port from here.

# --- PostgreSQL ---
POSTGRES_USER=airquality
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=airquality
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# --- Kafka (KRaft, single node) ---
# Any base64 UUID; generate one with: docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Host port for clients outside Docker (inside Docker, use kafka:9092)
KAFKA_EXTERNAL_PORT=9094
KAFKA_TOPIC_PARTITIONS=3

# --- Spark ---
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- API ---
API_PORT=8000
LOG_LEVEL=INFO

# --- Dashboard ---
DASHBOARD_PORT=5173

# --- External data APIs (used later by ingestion) ---
AIR_QUALITY_API_KEY=
WEATHER_API_KEY=
